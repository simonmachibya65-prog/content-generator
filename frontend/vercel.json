{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://publift-api.vercel.app/api/$1" },
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ],
  "env": {
    "VITE_API_URL": "https://publift-api.vercel.app/api"
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
